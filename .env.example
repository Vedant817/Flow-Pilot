# Copy to .env.local and fill values

# App
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Clerk Auth (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/orders
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/orders

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
ADMIN_SECRET=replace-with-long-random-value

# Gmail ingestion (optional)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://your-ngrok-url/api/auth/callback/google
GOOGLE_REFRESH_TOKEN=1//xxx
GOOGLE_TOPIC_NAME=projects/PROJECT/topics/Flow-Pilot

# AI overrides (optional)
AI_GEN_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
AI_GEN_MAX_TOKENS=320
AI_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Optional legacy fallback
# GEMINI_API_KEY=...
