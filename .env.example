# Copy to .env.local and supply real values locally or via a secret manager.
# Empty credentials are intentional. Never commit .env.local.
MONGO_URI=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Service operations only; interactive users need an active Clerk organization.
DEFAULT_ORG_ID=
ADMIN_SECRET=

# Local model defaults; first initialization downloads model weights.
AI_GEN_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
AI_GEN_MAX_TOKENS=320
AI_EMBED_MODEL=Xenova/all-MiniLM-L6-v2

# Optional Gmail ingestion.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
INTEGRATION_ENCRYPTION_KEY=
GOOGLE_TOPIC_NAME=
GMAIL_ORG_ID=

# Configure one authenticated webhook path. OIDC is preferred.
GMAIL_WEBHOOK_SECRET=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
